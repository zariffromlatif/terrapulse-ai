# ProofPath AI Configuration
# Gemini API Key (optional for local/test mode with deterministic fallback, required for live Gemini multimodal extraction)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Server configuration
PORT=8080
HOST=0.0.0.0

# Intelligence database path (optional, defaults to in-memory / local json cache)
PROOFPATH_DATA_DIR=./data
